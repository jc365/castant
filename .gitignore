# ============================================
# MÓDULOS DE NODE.JS
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ============================================
# ARCHIVOS COMPILADOS / DE SALIDA
# ============================================
dist/
build/
lib/
*.js
*.js.map
*.d.ts
*.d.ts.map
*.tsbuildinfo

# ============================================
# ENTORNO Y CONFIGURACIÓN LOCAL
# ============================================
.env
.env.local
.env.*.local
*.env
*.env.local

# ============================================
# ARCHIVOS DE DATOS Y ALMACENAMIENTO LOCAL
# ============================================
data/
uploads/
temp/
*.db
*.sqlite
*.sqlite3
*.log
logs/

# ============================================
# ARCHIVOS DE PRISMA (opcional si ya generaste cliente)
# ============================================
prisma/*.db
prisma/*.sqlite
prisma/*.sqlite3
prisma/migrations/*.sql
!prisma/migrations/migration_lock.toml

# ============================================
# CARPETAS DE ODYSSEUS (si tienes una copia local)
# ============================================
odysseus/
odysseus-*/
**/odysseus/**

# ============================================
# ARCHIVOS DEL SISTEMA OPERATIVO
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ============================================
# EDITORES Y HERRAMIENTAS DE DESARROLLO
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.vim/
*.iml
.project
.classpath
.settings/

# ============================================
