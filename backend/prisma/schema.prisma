generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String        @id
  name         String
  email        String        @unique
  rounds       RoundActor[]
  submissions  Submission[]
  participants Participant[]
}

model Casting {
  id           String        @id
  title        String
  description  String
  participants Participant[]
  rounds       Round[]
}

model Participant {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  castingId String?
  casting   Casting? @relation(fields: [castingId], references: [id])
  roundId   String?
  role      String
  createdAt DateTime @default(now())
}

model Round {
  id          String       @id
  number      Int
  castingId   String
  casting     Casting      @relation(fields: [castingId], references: [id])
  actors      RoundActor[]
  submissions Submission[]
}

model RoundActor {
  roundId String
  round   Round  @relation(fields: [roundId], references: [id])
  actorId String
  actor   User   @relation(fields: [actorId], references: [id])
  role    String @default("actor")

  @@id([roundId, actorId])
}

model Submission {
  id       String @id
  actorId  String
  roundId  String
  videoUrl String
  status   String @default("pending")
  score    Int    @default(0)
  feedback String @default("")

  actor User   @relation(fields: [actorId], references: [id])
  round Round @relation(fields: [roundId], references: [id])
}
