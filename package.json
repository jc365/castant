{
  "name": "castant",
  "version": "1.0.0",
  "scripts": {
    "test": "vitest --run",
    "test:verbo": "vitest --run --reporter=verbose",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage --run",
    "test:integration": "vitest --run tests/integration",
    "test:back": "vitest --run",
    "test:front": "cd frontend && npm test",
    "test:all": "concurrently \"npm run test:back\" \"npm run test:front\"",
    "dev:all": "concurrently --names \"BACKEND,FRONTEND,OPENCODE\" --prefix-colors \"blue,green,magenta\" \"cd backend && npm run dev\" \"cd frontend && npm run dev\" \"opencode web --port 3001\""
  },
  "devDependencies": {
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
